# Copy to .env and adjust. Everything is optional - with no values set,
# the app runs fully on SQLite + the built-in rule-based triage engine.

# Database (default: local SQLite file)
DATABASE_URL=sqlite:///./data/support_desk.db

# Optional LLM triage mode. Set an API key to let a model classify
# tickets and draft replies instead of the rule engine. Works with any
# OpenAI-compatible endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
